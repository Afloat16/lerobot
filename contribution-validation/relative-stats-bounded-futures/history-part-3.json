    "9fa2518461cb1c3cd7550cc499017845c7f47f5c4ab2d0e1260575464bba286b": {
      "function": "plan",
      "source": "    def plan(self, z: Tensor) -> Tensor:\n        \"\"\"Plan sequence of actions using TD-MPC inference.\n\n        Args:\n            z: (batch, latent_dim,) tensor for the initial state.\n        Returns:\n            (horizon, batch, action_dim,) tensor for the planned trajectory of actions.\n        \"\"\"\n        device = get_device_from_parameters(self)\n        batch_size = z.shape[0]\n\n        if self._prev_mean is None:\n            prev_mean = torch.zeros(\n                self.config.horizon, batch_size, self.config.action_feature.shape[0], device=device\n            )\n        else:\n            prev_mean = self._prev_mean\n\n        actions, mean = self._plan_step(z, prev_mean)\n        # Clone outputs we keep: CUDA-graph compile modes reuse output memory on the next call.\n        self._prev_mean = mean.clone()\n        return actions.clone()",
      "blobs": [
        "7fee75e647bc5a1b8b240df29bb45ad74f8853e3"
      ],
      "paths": [
        "src/lerobot/policies/tdmpc/modeling_tdmpc.py"
      ]
    },
    "2e7a4551c39b823fdfbca172637b1de7d316d9558f3c854f00514c8b3dd13c15": {
      "function": "compute_relative_action_stats",
      "source": "def compute_relative_action_stats(\n    dataloader,\n    state_key: str = \"observation.state\",\n    num_batches: int | None = None,\n) -> tuple[torch.Tensor, torch.Tensor]:\n    \"\"\"Compute per-timestep mean/std from relative actions.\"\"\"\n    all_rel = []\n    for i, batch in enumerate(dataloader):\n        if num_batches is not None and i >= num_batches:\n            break\n        action, state = batch[\"action\"], batch[state_key]\n        current_pos = state[:, -1, :] if state.dim() == 3 else state\n        min_dim = min(action.shape[-1], current_pos.shape[-1])\n        rel = action.clone()\n        rel[..., :min_dim] -= current_pos[:, None, :min_dim]\n        all_rel.append(rel)\n    \n    all_rel = torch.cat(all_rel, dim=0)\n    return all_rel.mean(dim=0), all_rel.std(dim=0).clamp(min=1e-6)",
