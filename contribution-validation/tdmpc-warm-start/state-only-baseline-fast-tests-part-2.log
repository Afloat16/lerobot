2026-11-16T21:52:40.4915103Z       "source": "    def forward(self, observation, step_count):\n        t0 = step_count.item() == 0\n        obs = {\n            \"rgb\": observation[\"camera\"],\n            \"state\": observation[\"robot_state\"],\n        }\n        return self.act(obs, t0=t0, step=self.step)"
