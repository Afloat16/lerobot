2026-11-16T21:52:40.6556962Z         "lerobot/common/policies/tdmpc/policy.py"
2026-11-16T21:52:40.6557031Z       ],
2026-11-16T21:52:40.6558344Z       "source": "    def select_action(self, observation, step_count):\n        t0 = step_count.item() == 0\n\n        # TODO(rcadene): remove unsqueeze hack...\n        if observation[\"image\"].ndim == 3:\n            observation[\"image\"] = observation[\"image\"].unsqueeze(0)\n            observation[\"state\"] = observation[\"state\"].unsqueeze(0)\n\n        obs = {\n            # TODO(rcadene): remove contiguous hack...\n            \"rgb\": observation[\"image\"].contiguous(),\n            \"state\": observation[\"state\"].contiguous(),\n        }\n        action = self.act(obs, t0=t0, step=self.step.item())\n        return action"
2026-11-16T21:52:40.6558415Z     },
2026-11-16T21:52:40.6558566Z     "bf2933126945510085e80c7f87c78b9af5c2a747d82d6a9a45f6a0580f7a2fb5": {
2026-11-16T21:52:40.6558629Z       "blobs": [
2026-11-16T21:52:40.6558729Z         "a5e5fb0072336439ad79e78a32f4d4e0474bf846"
2026-11-16T21:52:40.6558790Z       ],
