2026-11-16T21:52:40.7097065Z       ],
2026-11-16T21:52:40.7097237Z       "function": "predict_action_chunk",
2026-11-16T21:52:40.7097449Z       "paths": [
2026-11-16T21:52:40.7097645Z         "src/lerobot/policies/tdmpc/modeling_tdmpc.py"
2026-11-16T21:52:40.7097900Z       ],
2026-11-16T21:52:40.7100878Z       "source": "    def predict_action_chunk(self, batch: dict[str, Tensor], **kwargs) -> Tensor:\n        \"\"\"Predict a chunk of actions given environment observations.\"\"\"\n        batch = {key: torch.stack(list(self._queues[key]), dim=1) for key in batch if key in self._queues}\n\n        # Remove the time dimensions as it is not handled yet.\n        for key in batch:\n            assert batch[key].shape[1] == 1\n            batch[key] = batch[key][:, 0]\n\n        # NOTE: Order of observations matters here.\n        encode_keys = []\n        if self.config.image_features:\n            encode_keys.append(OBS_IMAGE)\n        if self.config.env_state_feature:\n            encode_keys.append(OBS_ENV_STATE)\n        encode_keys.append(OBS_STATE)\n        z = self.model.encode({k: batch[k] for k in encode_keys})\n        if self.config.use_mpc:  # noqa: SIM108\n            actions = self.plan(z)  # (horizon, batch, action_dim)\n        else:\n            # Plan with the policy (\u03c0) alone. This always returns one action so unsqueeze to get a\n            # sequence dimension like in the MPC branch.\n            actions = self.model.pi(z).unsqueeze(0)\n\n        actions = torch.clamp(actions, -1, +1)\n\n        actions = self.unnormalize_outputs({ACTION: actions})[ACTION]\n        return actions"
